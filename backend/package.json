{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend da plataforma IntelliFit",
  "scripts": {
    "dev": "npm run migrate:chat && tsx watch src/server.ts",
    "validate:ml": "node --import tsx --test tests/ml.test.ts tests/ml-evaluation.test.ts tests/ml-benchmark.test.ts",
    "validate:chat": "node --import tsx --test tests/chat-rules.test.ts tests/chat-flow.test.ts tests/chat-routing.test.ts tests/chat-api.test.ts",
    "validate:all": "npm run typecheck && npm run validate:chat && npm run validate:ml && npm run validate:recipes",
    "migrate:chat": "node --import tsx src/scripts/migrate-chat.ts",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "validate:recipes": "node --import tsx --test tests/recipe-network.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
